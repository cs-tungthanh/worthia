{
  "name": "wealth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc -b",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply wealth-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wealth-db --remote",
    "db:backup": "wrangler d1 export wealth-db --remote --output backup.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@mantine/charts": "9.7.5",
    "@mantine/core": "^9.7.5",
    "@mantine/dates": "^9.7.5",
    "@mantine/form": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
